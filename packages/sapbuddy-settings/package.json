{
  "name": "sapbuddy-settings",
  "version": "0.1.0",
  "description": "SapBuddy SAP 连接管理 —— DSH Web 设置界面（多连接配置 + 切换启用）。宿主 webServer 路由 + 客户端 settings.section",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc && node scripts/build-client.mjs",
    "test": "node --test test/",
    "check": "tsc --noEmit"
  },
  "keywords": [
    "sap",
    "abap",
    "deepseek-harness",
    "cordis",
    "dsh",
    "settings"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "sapbuddy-tools": "file:../sapbuddy-tools"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  }
}
