{
  "name": "sapbuddy-settings-ui",
  "version": "0.2.0",
  "description": "SapBuddy SAP 连接设置页（客户端 UI）——注册 DSH 设置界面 settings.section，经 sapbuddy-settings 的同源 HTTP API 读写连接配置",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "check": "node scripts/build-client.mjs",
    "prepack": "node scripts/build-client.mjs"
  },
  "keywords": [
    "sap",
    "abap",
    "deepseek-harness",
    "cordis",
    "dsh",
    "settings"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gxx950224/sapbuddy-dsh.git"
  },
  "homepage": "https://github.com/gxx950224/sapbuddy-dsh#readme",
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  }
}
